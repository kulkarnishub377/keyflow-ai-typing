{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeyFlow Learning Recommendation",
  "type": "object",
  "required": ["mode", "minutes", "focus_keys"],
  "properties": {
    "mode": {"type": "string"},
    "minutes": {"type": "integer", "minimum": 1, "maximum": 30},
    "focus_keys": {"type": "array", "items": {"type": "string"}, "maxItems": 10}
  }
}
